# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
COLLAB_PORT=1234

# ─── Origins ─────────────────────────────────────────────────────────────────
# Primary origin the frontend is served from.
CLIENT_ORIGIN=http://localhost:5173

# Additional comma-separated origins that are allowed by CORS.
# In production add your Vercel URL here:
# CORS_ALLOWED_ORIGINS=https://colabcode-pi.vercel.app
CORS_ALLOWED_ORIGINS=

# ─── Cross-origin cookie flag ─────────────────────────────────────────────────
# Set to "true" whenever the frontend and backend run on different origins
# (e.g. Vercel frontend + Render backend).  This forces SameSite=None; Secure
# on auth cookies, which is required for cross-site cookie delivery.
# Leave unset or "false" for local development.
CROSS_ORIGIN_COOKIES=false

# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/multicoder
REDIS_URL=redis://127.0.0.1:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ─── Code execution ──────────────────────────────────────────────────────────
JUDGE0_URL=http://localhost:2358
JUDGE0_KEY=
HOST_RUNNER_ENABLED=true
HOST_RUN_TIMEOUT_MS=6000

# ─── Mail (Resend HTTP API) ──────────────────────────────────────────────────
# SMTP (ports 25/465/587) is blocked on Render free tier since Sep 2025.
# Resend sends over HTTPS (port 443) and works on all hosts.
#
# Setup:
#   1. Sign up at https://resend.com (free: 3 000 emails/month)
#   2. Create an API key at https://resend.com/api-keys
#   3. Verify your sending domain at https://resend.com/domains
#   4. Set MAIL_FROM to an address on your verified domain
#
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Colab Code <no-reply@yourdomain.com>
